[application]
config/name="Ashfall: The Hollow Vigil"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.02, 0.027, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.02, 0.027, 1)

[input]
camera_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
camera_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
camera_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
camera_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
cancel_placement={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
